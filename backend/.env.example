# Copier en `backend/.env` et remplir. Ce fichier-ci est commité, `.env` JAMAIS.

# Identifiant de l'opérateur.
AUTH_USERNAME=

# Hash bcrypt du mot de passe — jamais le mot de passe en clair.
# Générer avec :  python hash_password.py
AUTH_PASSWORD_HASH=

# ── Espace invité (démonstration) ─────────────────────────────────────────────
# Facultatif : par défaut, `guest` / `guest`, accès complet SAUF l'onglet Admin.
# Laisser GUEST_USERNAME vide FERME l'espace invité.
# GUEST_USERNAME=guest
# GUEST_PASSWORD_HASH=   # hash bcrypt (python hash_password.py) pour un autre mdp

# Clé de signature des jetons de session (32 octets mini).
# Générer avec :  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# `true` en production (HTTPS obligatoire), `false` en dev sur localhost.
# En HTTP avec `false`, le cookie de session circule en clair.
COOKIE_SECURE=false
